# Copy to .env and fill in. Any OpenAI-compatible chat endpoint works (vLLM, LiteLLM, Ollama,
# LM Studio, a hosted API); the model must accept images, since some answers are read from figures.
# Give the address without /v1. An endpoint on this machine is host.docker.internal.
GEN_BASE_URL=http://host.docker.internal:11434
GEN_MODEL=qwen2.5vl:7b
GEN_API_KEY=

# Retrieval models, run in the container (GPU if present). The scores in the README were measured
# with these defaults and Qwen3.8 as the generator.
# EMBEDDER=st:Qwen/Qwen3-Embedding-0.6B
# RERANKER=qwen:Qwen/Qwen3-Reranker-4B

# Without a GPU, the 4B reranker is slow on a CPU. Point it at a rerank endpoint instead
# (vLLM, Infinity or TEI serving /v1/rerank):
# RERANKER=http:Qwen/Qwen3-Reranker-4B
# RERANK_BASE_URL=http://host.docker.internal:8001
# RERANK_API_KEY=

# 0 keeps no record of questions and answers (otherwise they go to the data volume).
# RECORD_ANSWERS=1
